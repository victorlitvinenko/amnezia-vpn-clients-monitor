{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/coverage/**", "**/dist/**", "**/node_modules/**", "package-lock.json"],
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": true,
  "trailingComma": "none"
}
